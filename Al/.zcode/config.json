{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/hook_echo.py"],
              "timeoutMs": 10000
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/spec_check.py"],
              "timeoutMs": 10000
            },
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/py_check.py"],
              "timeoutMs": 10000
            }
          ]
        }
      ]
    }
  }
}
