#!/usr/bin/env python
# Git pre-commit hook: проверяет синтаксис staged .py файлов перед коммитом.
# Мир хуков другой, чем у ZCode-хуков: вход = git diff --cached, запрет = любой
# ненулевой exit (не только 2). Инфраструктурный сбой git не блокирует коммит
# (fail-open); найденная синтаксическая ошибка блокирует (exit 1).
# Автор исходной идеи: пользователь; правки: fail-open на git, регистр пути.
import os
import subprocess
import sys


def get_staged_python_files():
    """Список staged .py файлов (добавленных/изменённых), пути от корня репо."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        check=False,   # fail-open: нет git / не репо → не блокируем коммит
    )
    if result.returncode != 0:
        sys.stderr.write("pre-commit: git недоступен, проверку синтаксиса пропускаю\n")
        return []
    files = result.stdout.strip().splitlines()
    return [f for f in files if f.lower().endswith(".py") and os.path.isfile(f)]


def check_syntax(filepath):
    """True, если файл компилируется; иначе печатает строку и текст ошибки."""
    try:
        with open(filepath, "rb") as f:
            source = f.read()
        compile(source, filepath, "exec")
        return True
    except SyntaxError as e:
        print(f"{filepath}:{e.lineno}: {e.msg}")
        print(e.text.strip() if e.text else "")
        return False


def main():
    files = get_staged_python_files()
    if not files:
        return 0

    failed = [f for f in files if not check_syntax(f)]
    if failed:
        print(f"Синтаксические ошибки в {len(failed)} файл(ах). Коммит отменён.")
        return 1

    print(f"Синтаксис OK ({len(files)} файл(ов)).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
